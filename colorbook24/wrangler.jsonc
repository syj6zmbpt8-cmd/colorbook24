{
  "name": "colorbook24",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [ { "pattern": "colorbook24.twentyfourmedia.nl", "custom_domain": true } ]
}
